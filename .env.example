# ===== 基础 =====
APP_ENV=dev
APP_PORT=8000

# ===== Java 业务系统（yshop-drink-boot3 单进程 yshop-server）=====
JAVA_BASE_URL=http://127.0.0.1:48081
# 内网 HMAC 签名密钥（与 Java 侧共享；X-Internal-Sign）
JAVA_INTERNAL_SECRET=change-me-in-prod
# 工具调用上游超时（秒）
JAVA_TIMEOUT_SECONDS=10

# ===== 鉴权（方案A：直读 yshop Redis 校验 opaque token；方案B：introspection 待 Java 新增接口）=====
AUTH_MODE=redis
AUTH_CACHE_TTL_SECONDS=30

# ===== LLM（DeepSeek 直连，OpenAI 兼容端点；gateway.py 留 adapter 可切 One-API/LiteLLM）=====
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxx
LLM_MODEL_MAIN=deepseek-chat
LLM_MODEL_LIGHT=deepseek-chat
LLM_TIMEOUT_SECONDS=60
# Function Calling 最大轮次
FC_MAX_ROUNDS=6

# ===== Redis（复用 yshop 实例，ai-service 用 db 2 做限流/缓存）=====
REDIS_URL=redis://127.0.0.1:6379/2
YSHOP_REDIS_URL=redis://127.0.0.1:6379/0

# ===== MySQL（ai-service 自有库，不碰 yshop 业务库）=====
MYSQL_URL=mysql+pymysql://root:change-me@127.0.0.1:3306/ai_copilot?charset=utf8mb4

# ===== 向量库（chroma local 内嵌模式演示；生产 Milvus 用 VECTOR_DB_URL）=====
VECTOR_DB_BACKEND=chroma
VECTOR_DB_URL=http://127.0.0.1:19530
CHROMA_PERSIST_DIR=./data/chroma

# ===== Embedding（API 方案，硅基流动/阿里均可，OpenAI 兼容）=====
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_MODEL=BAAI/bge-m3

# ===== 限流与配额 =====
RATE_LIMIT_USER_PER_MIN=10
RATE_LIMIT_IP_PER_MIN=30
RATE_LIMIT_USER_PER_DAY=200
TOKEN_QUOTA_PER_MEMBER_PER_DAY=50000

# ===== 订单确认态 =====
ORDER_PREVIEW_TTL_SECONDS=120

# ===== 审计 =====
AUDIT_ENCRYPT=false

# ===== dev 联调（仅 APP_ENV=dev）=====
# yshop 开启 mock-enable 时，工具透传给 yshop 的固定 mock token（test{userId}）
DEV_MOCK_UPSTREAM_TOKEN=
